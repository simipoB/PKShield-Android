<!-- The NSP / XCI extractor (dm/tools/nx_extract, unchanged source, LibHac) built with .NET NativeAOT as an Android arm64 executable: the app unpacks the player's
     own dump with the player's own keys on the phone. Build on Linux (WSL works) with the Android NDK: build_extract_aot.sh. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>nx_extract</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeIdentifier>linux-bionic-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../tools/nx_extract/Program.cs" />
    <PackageReference Include="LibHac" Version="0.19.0" />
  </ItemGroup>
</Project>
