#version 450
// The end-of-submission barrier test: the GPU writes a known pattern into host-visible memory from a shader (as the game's compute and
// fragment shaders write buffers the game reads back), then the CPU checks it after the fence.
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint seed; uint n; } p;
layout(std430, binding = 0) writeonly buffer B { uint d[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) d[i] = p.seed ^ (i * 2654435761u);
}
