#version 450
// A texture the game reads as a different type: an RGBA8 image (MUTABLE_FORMAT) written as a render target, sampled through an R32_UINT view.
// Drivers that compress render targets (AFBC on Mali, DCC on RDNA / Xclipse) must decompress or skip compression for such images.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform usampler2D t;
layout(std430, binding = 1) writeonly buffer B { uint d[]; };
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    d[c.y * 16 + c.x] = texelFetch(t, c, 0).r;
}
