int alv(bool alpha, int j) { return alpha ? AW6[j] : AW8[j]; }
int astc_fit(int nc, ivec4 e0, ivec4 e1, bool alpha) {
    int nl = alpha ? 6 : 8, err = 0;
    for (int i = 0; i < 16; i++) {
        int be = 0x7fffffff, bi = 0;
        for (int j = 0; j < nl; j++) {
            int d2 = 0, lv = alv(alpha, j);
            for (int c = 0; c < nc; c++) { int got = ((e0[c] * 257) * (64 - lv) + (e1[c] * 257) * lv + 32) >> 14, d = got - ch(T[i], c); d2 += d * d; }
            if (d2 < be) { be = d2; bi = j; }
        }
        err += be; AWI[i] = bi;
    }
    return err;
}
uvec4 astc_encode_rgba() {
    bool alpha = false; for (int i = 0; i < 16; i++) alpha = alpha || ch(T[i], 3) != 255;
    int nc = alpha ? 4 : 3;
    vec4 mean = vec4(0.0); mat4 cov = mat4(0.0); vec4 ax = vec4(1.0);
    for (int i = 0; i < 16; i++) for (int c = 0; c < nc; c++) mean[c] += float(ch(T[i], c)) / 16.0;
    for (int i = 0; i < 16; i++) for (int a = 0; a < nc; a++) for (int b = 0; b < nc; b++) cov[a][b] += (float(ch(T[i], a)) - mean[a]) * (float(ch(T[i], b)) - mean[b]);
    for (int it = 0; it < 8; it++) {
        vec4 n = vec4(0.0); float l = 0.0; for (int a = 0; a < nc; a++) for (int b = 0; b < nc; b++) n[a] += cov[a][b] * ax[b];
        for (int a = 0; a < nc; a++) l += n[a] * n[a];
        if (l < 1e-9) break;
        l = sqrt(l); for (int a = 0; a < nc; a++) ax[a] = n[a] / l;
    }
    float tlo = 0.0, thi = 0.0; for (int i = 0; i < 16; i++) { float t = 0.0; for (int c = 0; c < nc; c++) t += (float(ch(T[i], c)) - mean[c]) * ax[c]; tlo = min(tlo, t); thi = max(thi, t); }
    ivec4 e0 = ivec4(0, 0, 0, 255), e1 = ivec4(0, 0, 0, 255);
    for (int c = 0; c < nc; c++) { e0[c] = clampi(int(floor(mean[c] + tlo * ax[c] + 0.5)), 0, 255); e1[c] = clampi(int(floor(mean[c] + thi * ax[c] + 0.5)), 0, 255); }
    int best = astc_fit(nc, e0, e1, alpha); ivec4 b0 = e0, b1 = e1; int bw[16]; for (int i = 0; i < 16; i++) bw[i] = AWI[i];
    for (int it = 0; it < 2; it++) {
        float s00 = 0.0, s01 = 0.0, s11 = 0.0; vec4 r0 = vec4(0.0), r1 = vec4(0.0);
        for (int i = 0; i < 16; i++) { float f = float(alv(alpha, AWI[i])) / 64.0, g = 1.0 - f; s00 += g * g; s01 += g * f; s11 += f * f; for (int c = 0; c < nc; c++) { r0[c] += g * float(ch(T[i], c)); r1[c] += f * float(ch(T[i], c)); } }
        float det = s00 * s11 - s01 * s01; if (abs(det) < 1e-6) break;
        for (int c = 0; c < nc; c++) { e0[c] = clampi(int(floor((r0[c] * s11 - r1[c] * s01) / det + 0.5)), 0, 255); e1[c] = clampi(int(floor((r1[c] * s00 - r0[c] * s01) / det + 0.5)), 0, 255); }
        int err = astc_fit(nc, e0, e1, alpha); if (err >= best) break;
        best = err; b0 = e0; b1 = e1; for (int i = 0; i < 16; i++) bw[i] = AWI[i];
    }
    if (b1[0] + b1[1] + b1[2] < b0[0] + b0[1] + b0[2]) { ivec4 t = b0; b0 = b1; b1 = t; for (int i = 0; i < 16; i++) bw[i] = alpha ? bw[i] ^ 1 : 7 - bw[i]; }
    A = uvec4(0u);
    bput(0, 11, alpha ? 0x43u : 0x53u, false);
    bput(13, 4, alpha ? 12u : 8u, false);
    for (int c = 0; c < nc; c++) { bput(17 + 16 * c, 8, uint(b0[c]), false); bput(25 + 16 * c, 8, uint(b1[c]), false); }
    if (!alpha) { for (int i = 0; i < 16; i++) bput(3 * i, 3, uint(bw[i]), true); return A; }
    const int SQ0[10] = int[](-1, 0, -1, 2, -1, 4, -1, 5, -1, 7), SQ1[10] = int[](0, 2, 1, 2, 2, 1, 3, 2, 4, 1);
    int pos = 0;
    for (int g = 0; g < 4; g++) {
        int t = 0, k = 1, m[5] = int[](0, 0, 0, 0, 0);
        for (int j = 0; j < 5 && g * 5 + j < 16; j++) { int v = bw[g * 5 + j]; m[j] = v & 1; t += (v >> 1) * k; k *= 3; }
        k = int(TRIT_ENC[t]);
        for (int q = 0; q < 10 && pos < 42; q++) {
            if (SQ0[q] < 0) { bput(pos, 1, uint(m[SQ1[q]]), true); pos++; }
            else { int n = SQ1[q]; if (pos + n > 42) n = 42 - pos; bput(pos, n, uint(k >> SQ0[q]), true); pos += n; }
        }
    }
    return A;
}
uint h2uf(uint h, int mb) {
    if ((h & 0x8000u) != 0u) return 0u;
    if ((h >> 10 & 31u) == 31u) return (31u << mb) | ((h & 0x3ffu) != 0u ? 1u : 0u);
    uint v = (h + (1u << (9 - mb))) >> (10 - mb);
    return v >> mb >= 31u ? (30u << mb) | ((1u << mb) - 1u) : v;
}

void main() {
    uvec3 g = gl_GlobalInvocationID; if (g.x >= pc.bw || g.y >= pc.bh || g.z >= pc.nz) return;
    int k = KIND, nbw = (k == 1 || k == 4 || k == -4) ? 2 : 4;
    uint ib = pc.in_off + g.z * pc.in_slice + g.y * pc.in_row + g.x * uint(nbw);
    B = uvec4(src[ib], src[ib + 1u], nbw == 4 ? src[ib + 2u] : 0u, nbw == 4 ? src[ib + 3u] : 0u);
    // decode into T / H0 H1 (BC4 / BC5 into T's low bytes)
    if (k == 1) bc1_color(B.x, B.y, false);
    else if (k == 2) { bc1_color(B.z, B.w, true); for (int i = 0; i < 16; i++) T[i] = (T[i] & 0xffffffu) | (((i < 8 ? B.x : B.y) >> (4 * (i & 7)) & 15u) * 17u) << 24; }
    else if (k == 3) { bc1_color(B.z, B.w, true); bc4_values(B.x, false); for (int i = 0; i < 16; i++) T[i] = (T[i] & 0xffffffu) | uint(V4[bc4_index(B.x, B.y, i)] & 255) << 24; }
    else if (k == 4 || k == -4) { bc4_values(B.x, k < 0); for (int i = 0; i < 16; i++) T[i] = uint(V4[bc4_index(B.x, B.y, i)] & 255); }
    else if (k == 5 || k == -5) {
        bc4_values(B.x, k < 0); for (int i = 0; i < 16; i++) T[i] = uint(V4[bc4_index(B.x, B.y, i)] & 255);
        bc4_values(B.z, k < 0); for (int i = 0; i < 16; i++) T[i] |= uint(V4[bc4_index(B.z, B.w, i)] & 255) << 8;
    }
    else if (k == 6 || k == -6) bc6h(k < 0);
    else if (k == 7) bc7();
    uint ob = pc.out_off + g.z * pc.out_slice;
    if (MODE == 0) {   // texels: rows of 4 * bw texels (tb bytes each), the block's 4x4 at (4 g.x, 4 g.y)
        for (int y = 0; y < 4; y++) {
            uint row = ob + (g.y * 4u + uint(y)) * pc.out_row;
            if (k == 4 || k == -4) dst[row + g.x] = T[y * 4] | T[y * 4 + 1] << 8 | T[y * 4 + 2] << 16 | T[y * 4 + 3] << 24;
            else if (k == 5 || k == -5) { dst[row + g.x * 2u] = (T[y * 4] & 0xffffu) | T[y * 4 + 1] << 16; dst[row + g.x * 2u + 1u] = (T[y * 4 + 2] & 0xffffu) | T[y * 4 + 3] << 16; }
            else if (k == 6 || k == -6) for (int x = 0; x < 4; x++) { dst[row + g.x * 8u + uint(x) * 2u] = H0[y * 4 + x]; dst[row + g.x * 8u + uint(x) * 2u + 1u] = H1[y * 4 + x]; }
            else for (int x = 0; x < 4; x++) dst[row + g.x * 4u + uint(x)] = T[y * 4 + x];
        }
        return;
    }
    if (k >= 1 && k <= 3) {   // EAC alpha, then ETC2 colour
        for (int i = 0; i < 16; i++) EV[i] = ch(T[i], 3);
        uvec2 a = eac_encode(0), c = etc2_encode_rgb(); uint o = ob + g.y * pc.out_row + g.x * 4u;
        dst[o] = a.x; dst[o + 1u] = a.y; dst[o + 2u] = c.x; dst[o + 3u] = c.y;
    } else if (k == 4 || k == 5) {
        uint o = ob + g.y * pc.out_row + g.x * uint(k == 4 ? 2 : 4);
        for (int c = 0; c < k - 3; c++) { for (int i = 0; i < 16; i++) EV[i] = (ch(T[i], c) * 2047 + 127) / 255; uvec2 e = eac_encode(1); dst[o + uint(2 * c)] = e.x; dst[o + uint(2 * c) + 1u] = e.y; }
    } else if (k == -4 || k == -5) {
        uint o = ob + g.y * pc.out_row + g.x * uint(k == -4 ? 2 : 4);
        for (int c = 0; c < -k - 3; c++) {
            for (int i = 0; i < 16; i++) { int s = int(uint(ch(T[i], c)) << 24) >> 24; s = s < -127 ? -127 : s; EV[i] = divtz(s * 1023 + (s < 0 ? -63 : 63), 127); }
            uvec2 e = eac_encode(2); dst[o + uint(2 * c)] = e.x; dst[o + uint(2 * c) + 1u] = e.y;
        }
    } else if (k == 6) {   // B10G11R11 texels, rows of pc.out_row words; edge texels outside w x h left alone
        for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
            uint tx = g.x * 4u + uint(x), ty = g.y * 4u + uint(y); if (tx >= pc.w || ty >= pc.h) continue;
            uint r = H0[y * 4 + x] & 0xffffu, gg = H0[y * 4 + x] >> 16, b = H1[y * 4 + x] & 0xffffu;
            dst[ob + ty * pc.out_row + tx] = h2uf(r, 6) | h2uf(gg, 6) << 11 | h2uf(b, 5) << 22;
        }
    } else if (k == 7) {
        uvec4 a = astc_encode_rgba(); uint o = ob + g.y * pc.out_row + g.x * 4u;
        dst[o] = a.x; dst[o + 1u] = a.y; dst[o + 2u] = a.z; dst[o + 3u] = a.w;
    }
}
